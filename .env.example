# ==================================================
# Oracle Cloud configuration
# ==================================================

# Compartment or tenancy OCID used to create the instance
OCI_COMPARTMENT_ID="ocid1.tenancy.oc1..YOUR_OCID"

# Public subnet where the instance will be attached
OCI_SUBNET_ID="ocid1.subnet.oc1.YOUR_REGION.YOUR_OCID"

# ARM64/AArch64 image OCID
OCI_IMAGE_ID="ocid1.image.oc1.YOUR_REGION.YOUR_OCID"

# Availability Domains to try
OCI_AD_1="YOUR_PREFIX:YOUR_REGION-AD-1"
OCI_AD_2="YOUR_PREFIX:YOUR_REGION-AD-2"

# ==================================================
# Instance configuration
# ==================================================

INSTANCE_NAME="instance-a1-auto"

SSH_PUBLIC_KEY_FILE="$HOME/.ssh/oracle_a1.pub"

# Wait between complete retry cycles
RETRY_SECONDS=60

# Wait between OCI requests
PAUSE_BETWEEN_REQUESTS=5

# Send a "still running" notification every 6 hours
STATUS_NOTIFICATION_SECONDS=21600

# ==================================================
# Telegram notifications - optional
# ==================================================

# Leave empty to disable Telegram notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
